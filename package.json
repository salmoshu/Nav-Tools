{
  "name": "nav-tools",
  "version": "1.5.0",
  "main": "dist-electron/main/index.js",
  "description": "Nav-Tools is a desktop-grade visualization workbench built with Electron & Vue3, tailored for roboticists.",
  "author": "Winchell.Hu <winchell.hu@outlook.com>",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.renderer.config.ts",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:dir": "vue-tsc --noEmit && vite build",
    "publish": "pnpm run build:dir && electron-builder --publish always",
    "build:web": "vue-tsc --noEmit && vite build --config vite.renderer.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/core/**/*.ts\" \"electron/main/services/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\"",
    "lint:all": "eslint \"src/**/*.{ts,vue}\" \"electron/**/*.ts\"",
    "format": "prettier --write \"src/core/**/*.ts\" \"electron/main/services/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\"",
    "format:check": "prettier --check \"src/core/**/*.ts\" \"electron/main/services/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\"",
    "preview": "vite preview",
    "clean": "rimraf node_modules dist dist-electron release",
    "rebuild": "npm run clean && npm ci"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/leaflet": "^1.9.21",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "^39.2.7",
    "electron-builder": "^25.1.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-monaco-editor-esm": "^2.0.2",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@lucide/vue": "^1.25.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "codebuddy": "^1.0.0",
    "echarts": "^6.0.0",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.11.2",
    "element-resize-detector": "^1.2.4",
    "ffmpeg-static": "^5.2.0",
    "grid-layout-plus": "^1.1.0",
    "leaflet": "^1.9.4",
    "mathjs": "^14.7.0",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.53.0",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "^1.27.0",
    "pinia": "^3.0.3",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "vue-i18n": "^9.14.5",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "vuedraggable": "^4.1.0"
  }
}
